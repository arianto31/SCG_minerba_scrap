SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-key

# Login (WAJIB). Buat dengan:  python -m tools.hash_password
# Beberapa pengguna dipisah titik koma. Gunakan tanda kutip tunggal agar tanda $ tidak diubah.
AUTH_USERS='admin:pbkdf2_sha256$600000$isi-salt$isi-hash'

# Opsional: aktifkan fitur "Upload Dokumen (Foto/PDF)" dengan Gemini
GEMINI_API_KEY=your-gemini-api-key
# Opsional: ganti model (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
