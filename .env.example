SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-key

# Login (REQUIRED). Generate with:  python -m tools.hash_password
# Separate several users with semicolons. Use single quotes so the $ signs are not expanded.
AUTH_USERS='admin:pbkdf2_sha256$600000$your-salt$your-hash'

# Optional: enables "Scan a document (AI)" with Gemini
GEMINI_API_KEY=your-gemini-api-key
# Optional: change the model (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
